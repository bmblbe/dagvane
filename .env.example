# Dagvane — environment variable template
# Copy this file to .dagvane/secrets.env inside a session directory
# (or export these variables in your shell) and fill in real values.
#
#   cp .env.example .dagvane/secrets.env
#
# Never commit the real secrets.env file.

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

